/* pages/map/index.wxss — 地图首页样式 */
/* 注意: cover-view 不支持 CSS 变量和 box-shadow，全部使用硬编码颜色 */

.page-map {
  width: 100%;
  height: 100vh;
  position: relative;
}

.camp-map {
  width: 100%;
  height: 100vh;
}

/* ============ 顶部搜索栏 ============ */
.map-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 400;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 20rpx;
  background: #2d6a4f;
}

.city-sel {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #fff;
}

.city-name {
  font-size: 28rpx;
  font-weight: 600;
}

.city-arrow {
  font-size: 18rpx;
}

.search-box {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  margin: 0 16rpx;
}

.search-icon {
  font-size: 24rpx;
  color: #40916c;
}

.search-ph {
  font-size: 26rpx;
  color: #adb5bd;
}

/* ============ 营地数量提示 ============ */
.camp-count-badge {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 400;
  background: rgba(45, 106, 79, 0.92);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.cc-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

/* ============ 图例 ============ */
.map-legend {
  position: absolute;
  right: 24rpx;
  z-index: 400;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.lg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 40rpx;
}

.lg-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.lg-dot.free {
  background: #2d6a4f;
}

.lg-dot.paid {
  background: #f4a261;
}

.lg-dot.rv {
  background: #277da1;
}

.lg-text {
  font-size: 22rpx;
  color: #1a2e1f;
}

/* ============ 浮动按钮组 ============ */
.fab-group {
  position: absolute;
  right: 24rpx;
  bottom: 192rpx;
  z-index: 400;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.fab {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.fab-filter {
  background: #2d6a4f;
  color: #fff;
  position: relative;
}

.fab-filter-icon {
  width: 44rpx;
  height: 44rpx;
}

.fab-filter-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #ee6c4d;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  font-weight: 700;
  border: 3rpx solid #fff;
}

/* ============ 营地底部卡片 ============ */
.bottom-card {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 28rpx;
  z-index: 500;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  border: none;
}

.bc-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.bc-info {
  flex: 1;
}

.bc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.bc-addr {
  font-size: 24rpx;
  color: #6b7c70;
  margin-top: 6rpx;
}

.bc-close {
  color: #adb5bd;
  font-size: 36rpx;
}

.bc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.bc-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #d8f3dc;
  color: #2d6a4f;
}

.bc-tag.off {
  background: #eef0ee;
  color: #adb5bd;
}

.bc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 20rpx;
}

.bc-dist {
  font-size: 24rpx;
  color: #6b7c70;
}

.bc-btn {
  background: #2d6a4f;
  color: #fff;
  padding: 14rpx 32rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  line-height: 1.5;
}

/* ============ 积分不足弹窗 ============ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 6500;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pe-card {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 44rpx;
  text-align: center;
  position: relative;
}

.pe-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  color: #adb5bd;
  font-size: 36rpx;
}

.pe-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #fdecea;
  color: #ee6c4d;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  font-weight: 700;
}

.pe-title {
  font-size: 34rpx;
  font-weight: 700;
}

.pe-desc {
  font-size: 26rpx;
  color: #6b7c70;
  margin-top: 12rpx;
  line-height: 1.6;
}

.pe-points {
  font-weight: 700;
  color: #ee6c4d;
}

.pe-btn {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #2d6a4f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pe-tip {
  font-size: 24rpx;
  color: #adb5bd;
  margin-top: 20rpx;
}
