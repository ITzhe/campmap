<!-- pages/map/index.wxml — 地图首页 -->
<view class="page-map">
  <!-- 全屏地图 -->
  <map
    id="campMap"
    class="camp-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location="{{showLocation}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    enable-rotate="{{false}}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  >
    <!-- 顶部搜索栏 (使用动态状态栏高度避免重叠) -->
    <cover-view class="map-topbar" style="padding-top: {{statusBarHeight}}px;">
      <cover-view class="city-sel" bindtap="onCityTap">
        <cover-view class="city-name">{{cityName}}</cover-view>
        <cover-view class="city-arrow">▼</cover-view>
      </cover-view>
      <cover-view class="search-box" bindtap="onSearchTap">
        <cover-view class="search-icon">🔍</cover-view>
        <cover-view class="search-ph">搜索营地名称或地址</cover-view>
      </cover-view>
    </cover-view>

    <!-- 营地数量提示 -->
    <cover-view wx:if="{{campCount > 0 && !searchPanelVisible}}" class="camp-count-badge" style="top: {{topbarHeight + 8}}px;">
      <cover-view class="cc-text">附近 {{campCount}} 个营地</cover-view>
    </cover-view>

    <!-- 地图图例 -->
    <cover-view wx:if="{{!searchPanelVisible}}" class="map-legend" style="top: {{topbarHeight + 52}}px;">
      <cover-view class="lg">
        <cover-view class="lg-dot free"></cover-view>
        <cover-view class="lg-text">免费</cover-view>
      </cover-view>
      <cover-view class="lg">
        <cover-view class="lg-dot paid"></cover-view>
        <cover-view class="lg-text">收费</cover-view>
      </cover-view>
    </cover-view>

    <!-- 浮动按钮 -->
    <cover-view class="fab-group">
      <cover-view class="fab fab-filter" bindtap="openFilter">
        <cover-view class="fab-filter-text">筛选</cover-view>
        <cover-view wx:if="{{filterCount > 0}}" class="fab-filter-badge">{{filterCount}}</cover-view>
      </cover-view>
    </cover-view>

    <!-- 营地底部卡片 -->
    <cover-view wx:if="{{showBottomCard}}" class="bottom-card">
      <cover-view class="bc-head">
        <cover-view class="bc-info">
          <cover-view class="bc-name">{{selectedCamp.name}}</cover-view>
          <cover-view class="bc-addr">📍 {{selectedCamp.address || '暂无地址'}}</cover-view>
        </cover-view>
        <cover-view class="bc-close" bindtap="closeBottomCard">✕</cover-view>
      </cover-view>
      <!-- 天气信息 -->
      <cover-view wx:if="{{weatherLoading}}" class="bc-weather loading">天气加载中...</cover-view>
      <cover-view wx:elif="{{weatherInfo}}" class="bc-weather">{{weatherInfo}}</cover-view>
      <cover-view class="bc-tags">
        <cover-view wx:for="{{bottomCardTags}}" wx:key="label"
          class="bc-tag {{item.on ? '' : 'off'}}">{{item.label}}</cover-view>
      </cover-view>
      <cover-view class="bc-foot">
        <cover-view class="bc-dist">距您约 {{selectedCampDist}} km</cover-view>
        <cover-view class="bc-btn" bindtap="viewDetail">查看详情</cover-view>
      </cover-view>
    </cover-view>
  </map>

  <!-- 搜索浮层面板（在map组件外，可用普通view+input） -->
  <view wx:if="{{searchPanelVisible}}" class="search-panel">
    <!-- 搜索输入区 -->
    <view class="sp-header" style="padding-top: {{statusBarHeight}}px;">
      <view class="sp-bar">
        <view class="sp-back" bindtap="closeSearchPanel">‹</view>
        <view class="sp-input-wrap">
          <text class="sp-icon">🔍</text>
          <input class="sp-input" type="text" placeholder="搜索营地名称或地址"
            value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch"
            focus="{{searchPanelVisible}}" confirm-type="search" />
          <view wx:if="{{searchKeyword}}" class="sp-clear" bindtap="clearSearchInput">✕</view>
        </view>
        <view class="sp-btn" bindtap="doSearch">搜索</view>
      </view>
    </view>

    <!-- 搜索历史 -->
    <view class="sp-body" wx:if="{{!searchSearched && searchHistory.length > 0}}">
      <view class="sp-section-head">
        <text class="sp-section-title">搜索历史</text>
        <text class="sp-section-clear" bindtap="clearSearchHistory">清除</text>
      </view>
      <view class="sp-history-list">
        <view class="sp-history-item" wx:for="{{searchHistory}}" wx:key="*this"
          data-kw="{{item}}" bindtap="onTapHistory">{{item}}</view>
      </view>
    </view>

    <!-- 搜索中 -->
    <view class="sp-body" wx:if="{{searchSearching}}">
      <view class="sp-loading">搜索中...</view>
    </view>

    <!-- 搜索结果 -->
    <view class="sp-body" wx:if="{{searchSearched && !searchSearching}}">
      <view class="sp-result-tip" wx:if="{{searchResults.length > 0}}">共找到 {{searchResults.length}} 个营地</view>
      <view class="sp-empty" wx:if="{{searchResults.length === 0}}">
        <text class="sp-empty-icon">😅</text>
        <text class="sp-empty-text">未找到相关营地</text>
      </view>
      <view class="sp-result" wx:for="{{searchResults}}" wx:key="spot_code"
        data-spot="{{item}}" bindtap="onTapSearchResult">
        <view class="spr-top">
          <text class="spr-name">{{item.name}}</text>
          <text class="spr-badge {{item.isFree ? 'free' : 'paid'}}">{{item.isFree ? '免费' : '收费'}}</text>
        </view>
        <view class="spr-addr" wx:if="{{item.address}}">{{item.address}}</view>
        <view class="spr-tags" wx:if="{{item.tags}}">{{item.tags}}</view>
      </view>
    </view>
  </view>

  <!-- 筛选弹窗组件 -->
  <filter-sheet
    visible="{{filterVisible}}"
    filters="{{filters}}"
    camp-count="{{filteredCount}}"
    bind:confirm="onFilterConfirm"
    bind:reset="onFilterReset"
    bind:close="onFilterClose"
  />

  <!-- 积分不足弹窗 (推广期隐藏) -->
  <!--
  <view wx:if="{{showPointsModal}}" class="modal-mask" bindtap="closePointsModal">
    <view class="pe-card" catchtap="">
      <view class="pe-close" bindtap="closePointsModal">✕</view>
      <view class="pe-icon">✕</view>
      <view class="pe-title">积分不足</view>
      <view class="pe-desc">当前积分 <text class="pe-points">{{userPoints}}</text>，查看营地详情需 1 积分</view>
      <view class="pe-btn" bindtap="onModalCheckin">立即签到 +10积分</view>
      <view class="pe-tip">签到后即可查看营地详情</view>
    </view>
  </view>
  -->
</view>
