/* pages/profile/index.wxss — 编辑资料页样式 */
.page-profile {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.pp-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
  flex-shrink: 0;
}

.pp-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text);
}

.pp-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.pp-nav-placeholder {
  width: 56rpx;
}

/* 居中内容区 — flex:1 让它占满中间空间，内容垂直居中 */
.pp-center-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  gap: 48rpx;
}

/* 昵称卡片 — 居中显示 */
.pp-nick-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.pp-nick-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 24rpx;
}

.pp-field-box {
  background: var(--bg);
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
}

.pp-input {
  flex: 1;
  font-size: 32rpx;
  color: var(--text);
  height: 100%;
  text-align: center;
}

.pp-field-tip {
  font-size: 22rpx;
  color: var(--text-ph);
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.5;
}

/* 头像区 */
.pp-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.pp-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--green-light);
  border: 4rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pp-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pp-avatar-placeholder {
  font-size: 64rpx;
}

.pp-avatar-hint {
  font-size: 24rpx;
  color: var(--text-ph);
}

/* 保存按钮 — 底部固定 */
.pp-save-area {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.pp-save-btn {
  height: 96rpx;
  background: var(--green);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
}
