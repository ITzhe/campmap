<!-- pages/profile/index.wxml — 编辑个人资料页 -->
<view class="page-profile">
  <!-- 导航栏 -->
  <view class="pp-navbar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="pp-back" bindtap="goBack">‹</view>
    <view class="pp-nav-title">编辑资料</view>
    <view class="pp-nav-placeholder"></view>
  </view>

  <!-- 头像区 -->
  <view class="pp-avatar-section">
    <view class="pp-avatar-wrap" bindtap="chooseAvatarFromAlbum">
      <image wx:if="{{tempAvatarUrl}}" class="pp-avatar-img" src="{{tempAvatarUrl}}" mode="aspectFill" />
      <view wx:else class="pp-avatar-placeholder">🏕</view>
    </view>
    <view class="pp-avatar-hint">点击更换头像</view>
  </view>

  <!-- 昵称输入 -->
  <view class="pp-field-group">
    <view class="pp-field-label">昵称</view>
    <view class="pp-field-box">
      <input class="pp-input" type="nickname" placeholder="点击获取微信昵称"
        value="{{tempNick}}" bindinput="onNickInput" bindblur="onNickBlur" />
    </view>
    <view class="pp-field-tip">点击输入框可使用微信昵称</view>
  </view>

  <!-- 保存按钮 -->
  <view class="pp-save-area">
    <view class="pp-save-btn" bindtap="saveProfile">保存</view>
  </view>
</view>
