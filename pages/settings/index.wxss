/* pages/settings/index.wxss — 设置页面样式 */

.page-settings {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 分组 ============ */
.sec {
  margin: 24rpx 24rpx 0;
}

.sec-title {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 8rpx 12rpx 16rpx;
  font-weight: 500;
}

.sec-card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

/* picker 占满整行，保证内部 flex 布局正常 */
.sec-card picker {
  display: block;
  width: 100%;
}

/* ============ 设置项 ============ */
.set-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 2rpx solid var(--line);
}

/* 分组内最后一项（直接子元素）去掉分隔线 */
.sec-card > .set-item:last-child {
  border-bottom: none;
}

.set-label {
  font-size: 28rpx;
  color: var(--text);
}

.set-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.set-arrow {
  font-size: 32rpx;
  color: var(--text-ph);
  line-height: 1;
}

.set-value .set-arrow {
  margin-left: 4rpx;
}

/* ============ 退出登录 ============ */
.logout-wrap {
  padding: 48rpx 24rpx 24rpx;
}

.logout-btn {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  text-align: center;
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--red);
}
