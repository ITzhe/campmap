/* pages/feedback/index.wxss — 意见反馈页样式 */

.page-feedback {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 卡片 ============ */
.fb-card {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
}

.fb-h {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 22rpx;
}

.fb-h-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.fb-h-tip {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-2);
}

/* ============ 类型 chips ============ */
.fb-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.fb-chip {
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--line);
  font-size: 24rpx;
  color: var(--text-2);
  background: #fff;
  transition: all 0.15s;
}

.fb-chip.on {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
}

/* ============ 文本域 ============ */
.fb-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
  padding: 0;
}

.fb-ph {
  color: var(--text-ph);
}

.fb-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

/* ============ 输入框 ============ */
.fb-input {
  width: 100%;
  font-size: 26rpx;
  color: var(--text);
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--line);
}

/* ============ 提交按钮 ============ */
.fb-submit {
  margin: 32rpx 24rpx;
  height: 88rpx;
  background: var(--green);
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(45, 106, 79, 0.28);
}

.fb-submit:active {
  opacity: 0.88;
}

/* ============ 历史数量 ============ */
.fb-history {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

/* ============ 成功态 ============ */
.fb-success {
  margin: 80rpx 48rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 64rpx 40rpx;
  text-align: center;
}

.fb-success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--green-light);
  color: var(--green);
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.fb-success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 28rpx;
}

.fb-success-desc {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 14rpx;
  line-height: 1.6;
}

.fb-success-meta {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 18rpx;
}

.fb-success-btn {
  margin: 36rpx auto 0;
  width: 280rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: var(--green);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
