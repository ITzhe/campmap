<!-- pages/detail/index.wxml — 营地详情页 -->
<view class="page-detail">
  <!-- 顶部渐变区 + 自定义导航 -->
  <view class="detail-hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="dn-bar">
      <view class="dn-back" bindtap="goBack">‹</view>
      <view class="dn-title">营地详情</view>
    </view>
    <view class="hero-content">
      <view class="hero-deco">🏕</view>
      <view class="hero-name">{{camp.name || '营地详情'}}</view>
    </view>
  </view>

  <!-- 主体 -->
  <view class="detail-body">
    <!-- 地址 -->
    <view class="addr-line">
      <text class="addr-pin">📍</text>
      <text class="addr-text">{{camp.address || '暂无地址信息'}}</text>
    </view>

    <!-- 停车收费信息 -->
    <view class="card price-card">
      <view class="card-h"><view class="dot"></view>停车信息</view>
      <view class="price-row">
        <view class="price-badge {{parkingText === '收费' ? 'paid' : 'free'}}">{{parkingText}}</view>
        <text class="price-detail" wx:if="{{priceInfo}}">{{priceInfo}}</text>
        <text class="price-detail" wx:else>{{parkingText === '收费' ? '收费停车场' : '免费停车'}}</text>
      </view>
    </view>

    <!-- 过夜友好度评分 -->
    <view class="card overnight-card" wx:if="{{hasOvernightData && overnightInfo}}">
      <view class="card-h">
        <view class="dot"></view>过夜友好度
        <text class="overnight-source">{{overnightInfo.source}}</text>
      </view>
      <!-- 综合评分 -->
      <view class="overnight-score-row">
        <view class="overnight-score-left">
          <text class="overnight-score-num">{{overnightInfo.score}}</text>
          <text class="overnight-score-unit">/5.0</text>
        </view>
        <view class="overnight-score-right">
          <text class="overnight-stars">{{overnightInfo.stars}}</text>
          <text class="overnight-status">{{overnightInfo.statusEmoji}} {{overnightInfo.status}}</text>
        </view>
      </view>
      <!-- 5个维度 -->
      <view class="overnight-dims">
        <view class="overnight-dim">
          <text class="ov-dim-emoji">{{overnightInfo.noiseEmoji}}</text>
          <text class="ov-dim-label">噪音</text>
          <text class="ov-dim-val">{{overnightInfo.noise}}</text>
        </view>
        <view class="overnight-dim">
          <text class="ov-dim-emoji">{{overnightInfo.safetyEmoji}}</text>
          <text class="ov-dim-label">安全</text>
          <text class="ov-dim-val">{{overnightInfo.safety}}</text>
        </view>
        <view class="overnight-dim">
          <text class="ov-dim-emoji">{{overnightInfo.signalEmoji}}</text>
          <text class="ov-dim-label">信号</text>
          <text class="ov-dim-val">{{overnightInfo.signal}}</text>
        </view>
        <view class="overnight-dim">
          <text class="ov-dim-emoji">{{overnightInfo.groundEmoji}}</text>
          <text class="ov-dim-label">地面</text>
          <text class="ov-dim-val">{{overnightInfo.ground}}</text>
        </view>
      </view>
    </view>

    <!-- 地理坐标 -->
    <view class="geo-line">
      <text class="geo-label">地理坐标</text>
      <text class="geo-val">{{camp.latitude}}, {{camp.longitude}}</text>
    </view>

    <!-- 营地简介 -->
    <view class="card">
      <view class="card-h"><view class="dot"></view>营地简介</view>
      <view class="intro-text {{introExpanded ? 'expanded' : ''}}">{{camp.intro || '暂无简介'}}</view>
      <view class="intro-toggle" bindtap="toggleIntro">
        {{introExpanded ? '收起 ▲' : '展开 ▼'}}
      </view>
    </view>

    <!-- 配套设施 -->
    <view class="card">
      <view class="card-h"><view class="dot"></view>配套设施</view>
      <view class="fac-groups">
        <view class="fac-group" wx:for="{{facGroups}}" wx:for-item="group" wx:key="title">
          <view class="fac-group-title">{{group.title}}</view>
          <view class="fac-tags">
            <view class="fac-tag {{item.on ? 'on' : 'off'}}"
              wx:for="{{group.items}}" wx:for-item="item" wx:key="key">
              <text class="fac-emoji">{{item.emoji}}</text>
              <text class="fac-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 营地相册 -->
    <view class="card photo-card">
      <view class="card-h">
        <view class="dot"></view>营地相册
        <text class="photo-count">{{campPhotos.length}}张</text>
      </view>

      <!-- 照片网格 -->
      <view class="photo-grid" wx:if="{{campPhotos.length > 0}}">
        <view class="photo-item" wx:for="{{campPhotos}}" wx:key="id">
          <image src="{{item.url}}" mode="aspectFill" class="photo-img"
            bindtap="previewCampPhoto" data-idx="{{index}}" />
          <view wx:if="{{item.isMine}}" class="photo-del"
            catchtap="deleteCampPhoto" data-idx="{{index}}">✕</view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="photo-empty" wx:if="{{campPhotos.length === 0 && pendingPhotos.length === 0}}">
        <text class="photo-empty-text">暂无照片，快来上传第一张营地照片吧～</text>
      </view>

      <!-- 待上传照片预览 -->
      <view class="photo-grid" wx:if="{{pendingPhotos.length > 0}}">
        <view class="photo-item" wx:for="{{pendingPhotos}}" wx:key="id">
          <image src="{{item.path}}" mode="aspectFill" class="photo-img" />
          <view class="photo-del"
            catchtap="removePendingPhoto" data-idx="{{index}}">✕</view>
        </view>
      </view>

      <!-- 上传/提交按钮 -->
      <view class="photo-upload-row">
        <view class="photo-upload-btn {{uploadingPhoto ? 'disabled' : ''}}" bindtap="selectCampPhoto">
          <text class="photo-upload-icon">📷</text>
          <text class="photo-upload-text">{{uploadingPhoto ? '上传中...' : '选择照片'}}</text>
        </view>
        <view wx:if="{{pendingPhotos.length > 0}}" class="photo-submit-btn {{uploadingPhoto ? 'disabled' : ''}}" bindtap="submitCampPhotos">
          <text class="photo-submit-text">{{uploadingPhoto ? '提交中...' : '提交(' + pendingPhotos.length + ')'}}</text>
        </view>
      </view>
    </view>

    <!-- 营地备注 -->
    <view class="card memo-card" wx:if="{{hasMemo}}">
      <view class="card-h memo-h"><view class="dot memo-dot"></view>营地备注</view>
      <view class="memo-text">{{camp.memo}}</view>
    </view>

    <!-- 最新动态 -->
    <view class="card">
      <view class="card-h"><view class="dot"></view>营地动态</view>
      <view class="news-list">
        <view class="news-item" wx:for="{{newsList}}" wx:key="date">
          <view class="news-date">{{item.date}}</view>
          <view class="news-text">{{item.text}}</view>
        </view>
      </view>
    </view>

    <!-- 用户评价 -->
    <view class="card dynamics-card">
      <view class="card-h">
        <view class="dot"></view>用户评价
        <text class="dyn-count">{{dynamicsCount}}条</text>
      </view>

      <!-- 发布评价 -->
      <view class="dyn-publish-trigger" wx:if="{{!showPublishBox}}" bindtap="togglePublishBox">
        <text class="dyn-trigger-text">{{currentUserNick ? '写评论...' : '登录后写评论...'}}</text>
        <text class="dyn-trigger-icon">✏️</text>
      </view>
      <view class="dyn-publish" wx:if="{{showPublishBox}}">
        <view class="dyn-publish-header">
          <text class="dyn-publish-name">{{currentUserNick || '请先登录'}}</text>
          <text class="dyn-publish-collapse" bindtap="togglePublishBox">收起</text>
        </view>
        <textarea class="dyn-textarea" value="{{dynamicsInput}}" bindinput="onDynamicsInput"
          placeholder="分享你的露营体验..." maxlength="200" auto-height="true" />
        <!-- 评价图片 -->
        <view class="dyn-photos" wx:if="{{dynamicsPhotos.length > 0}}">
          <view class="dyn-photo-thumb" wx:for="{{dynamicsPhotos}}" wx:key="id">
            <image src="{{item.path}}" mode="aspectFill" class="dyn-photo-img" />
            <view class="dyn-photo-del" catchtap="delDynamicsPhoto" data-idx="{{index}}">✕</view>
          </view>
        </view>
        <view class="dyn-publish-bar">
          <view class="dyn-photo-btn" bindtap="addDynamicsPhoto">
            <text class="dyn-photo-btn-icon">📷</text>
            <text class="dyn-photo-btn-text">{{dynamicsPhotos.length > 0 ? dynamicsPhotos.length + '/6' : '添加图片'}}</text>
          </view>
          <view class="dyn-publish-right">
            <text class="dyn-char-count">{{dynamicsInput.length}}/200</text>
            <view class="dyn-publish-btn {{submittingDynamics ? 'disabled' : ''}}" bindtap="submitDynamics">发布</view>
          </view>
        </view>
      </view>

      <!-- 评价列表 -->
      <view class="dyn-list">
        <!-- 加载中 -->
        <view class="dyn-tip" wx:if="{{commentsLoading}}">加载中...</view>
        <!-- 空状态 -->
        <view class="dyn-tip" wx:if="{{!commentsLoading && dynamicsCount === 0}}">还没有评价，快来分享第一条吧～</view>
        <view class="dyn-item" wx:for="{{dynamicsList}}" wx:key="id"
          wx:if="{{dynamicsExpanded || index < 3}}">
          <view class="dyn-avatar">
            <image wx:if="{{item.avatarIsUrl}}" class="dyn-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else>{{item.avatar}}</text>
          </view>
          <view class="dyn-content">
            <view class="dyn-head">
              <text class="dyn-nick">{{item.nick}}</text>
              <text class="dyn-type-tag" wx:if="{{item.type === 'checkin'}}">打卡</text>
            </view>
            <view class="dyn-text">{{item.text}}</view>
            <!-- 评论图片 -->
            <view class="dyn-imgs" wx:if="{{item.photo_urls}}">
              <image wx:for="{{item.photo_urls}}" wx:for-item="img" wx:key="*this"
                src="{{img}}" mode="aspectFill" class="dyn-img"
                bindtap="previewCommentImg" data-urls="{{item.photo_urls}}" data-current="{{img}}" />
            </view>
            <view class="dyn-foot">
              <text class="dyn-date">{{item.date}}</text>
              <view class="dyn-foot-right">
                <view wx:if="{{item.isMine}}" class="dyn-delete-btn"
                  catchtap="deleteComment" data-idx="{{index}}">
                  <text class="dyn-delete-icon">🗑</text>
                </view>
                <view class="dyn-like {{item.liked ? 'liked' : ''}}"
                  catchtap="likeDynamics" data-idx="{{index}}">
                  <text class="dyn-like-icon">{{item.liked ? '❤️' : '🤍'}}</text>
                  <text class="dyn-like-count">{{item.likes}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 展开更多 -->
      <view class="dyn-toggle" wx:if="{{dynamicsCount > 3}}" bindtap="toggleDynamics">
        {{dynamicsExpanded ? '收起 ▲' : '查看全部' + dynamicsCount + '条评价 ▼'}}
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="detail-actionbar safe-bottom">
    <view class="ab-btn" bindtap="navigateCamp">
      <text class="ab-icon">🧭</text>
      <text class="ab-label">导航</text>
    </view>
    <view class="ab-btn" bindtap="shareCamp">
      <text class="ab-icon">📤</text>
      <text class="ab-label">分享</text>
    </view>
    <view class="ab-btn" bindtap="toggleFavorite">
      <text class="ab-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
      <text class="ab-label">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="ab-btn" bindtap="openCorrection">
      <text class="ab-icon">✏️</text>
      <text class="ab-label">纠错</text>
    </view>
    <view class="ab-btn ab-primary" bindtap="checkinCamp">
      <text class="ab-icon">📍</text>
      <text class="ab-label">打卡</text>
    </view>
  </view>

  <!-- 纠错弹窗 -->
  <view wx:if="{{showCorrection}}" class="correction-mask" bindtap="tryCloseCorrection">
    <view class="correction-sheet" catchtap="noop">
      <view class="cs-header">
        <text class="cs-title">营地纠错</text>
        <text class="cs-close" bindtap="tryCloseCorrection">✕</text>
      </view>

      <scroll-view scroll-y class="cs-body">
        <!-- 基本信息 -->
        <view class="cs-section">
          <view class="cs-label">营地名称</view>
          <input class="cs-input" placeholder="请输入营地名称"
            data-key="name" value="{{correctionData.name}}" bindinput="onCorrectionInput" />
        </view>
        <view class="cs-section">
          <view class="cs-label">详细地址</view>
          <input class="cs-input" placeholder="请输入详细地址"
            data-key="address" value="{{correctionData.address}}" bindinput="onCorrectionInput" />
        </view>
        <view class="cs-section">
          <view class="cs-label">营地简介</view>
          <textarea class="cs-textarea" placeholder="补充营地介绍"
            data-key="intro" value="{{correctionData.intro}}" bindinput="onCorrectionInput" maxlength="200" />
        </view>

        <!-- 设施状态 -->
        <view class="cs-section">
          <view class="cs-label">设施状态（点击修改）</view>
          <view class="cs-fac-grid">
            <view wx:for="{{correctionFacItems}}" wx:key="key"
              class="cs-fac-item {{item.on ? 'on' : 'off'}}"
              data-idx="{{index}}" bindtap="toggleCorrectionFac">
              <text class="cs-fac-emoji">{{item.emoji}}</text>
              <text class="cs-fac-label">{{item.label}}</text>
              <text class="cs-fac-status">{{item.on ? '✓' : '✕'}}</text>
            </view>
          </view>
        </view>

        <!-- 纠错照片 -->
        <view class="cs-section">
          <view class="cs-label">补充照片（选填）</view>
          <view class="cs-photo-grid">
            <view wx:for="{{correctionPhotos}}" wx:key="id" class="cs-photo-thumb">
              <image src="{{item.path}}" mode="aspectFill" class="cs-photo-img" />
              <view class="cs-photo-del" catchtap="delCorrectionPhoto" data-idx="{{index}}">✕</view>
            </view>
            <view wx:if="{{correctionPhotos.length < 6}}" class="cs-photo-add" bindtap="addCorrectionPhoto">
              <text class="cs-add-icon">+</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="cs-footer">
        <view class="cs-btn-cancel" bindtap="tryCloseCorrection">取消</view>
        <view class="cs-btn-submit {{submittingCorrection ? 'disabled' : ''}}" bindtap="submitCorrection">提交纠错</view>
      </view>
    </view>
  </view>

  <!-- 打卡评价弹窗 -->
  <view wx:if="{{showCheckinReview}}" class="checkin-mask" bindtap="closeCheckinReview">
    <view class="checkin-sheet" catchtap="noop">
      <view class="cs-header">
        <text class="cs-title">打卡评价</text>
        <text class="cs-close" bindtap="closeCheckinReview">✕</text>
      </view>

      <scroll-view scroll-y class="checkin-body">
        <!-- 引导文案 -->
        <view class="checkin-intro">
          <text class="checkin-intro-icon">💡</text>
          <text class="checkin-intro-text">你的真实体验会帮助其他车友找到靠谱的过夜点，感谢分享 🙏</text>
        </view>

        <!-- 星级评分 -->
        <view class="checkin-section">
          <view class="checkin-label">总体体验 <text class="checkin-optional">（必填）</text></view>
          <view class="checkin-stars">
            <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
              class="ck-star {{checkinRating >= item ? 'on' : ''}}"
              data-star="{{item}}" bindtap="onCheckinStarTap">★</view>
            <text class="ck-star-tip" wx:if="{{checkinRating > 0}}">{{checkinRating}}分</text>
          </view>
        </view>

        <!-- 能否过夜 -->
        <view class="checkin-section">
          <view class="checkin-label">能否过夜</view>
          <view class="checkin-tags">
            <view wx:for="{{checkinTagOptions.overnight}}" wx:key="value"
              class="ck-tag {{checkinOvernightStatus === item.value ? 'on' : ''}}"
              data-dim="overnightStatus" data-value="{{item.value}}" bindtap="onCheckinTagTap">
              <text class="ck-tag-emoji">{{item.emoji}}</text>
              <text class="ck-tag-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 噪音 -->
        <view class="checkin-section">
          <view class="checkin-label">噪音程度</view>
          <view class="checkin-tags">
            <view wx:for="{{checkinTagOptions.noise}}" wx:key="value"
              class="ck-tag {{checkinNoise === item.value ? 'on' : ''}}"
              data-dim="noise" data-value="{{item.value}}" bindtap="onCheckinTagTap">
              <text class="ck-tag-emoji">{{item.emoji}}</text>
              <text class="ck-tag-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 安全 -->
        <view class="checkin-section">
          <view class="checkin-label">安全程度</view>
          <view class="checkin-tags">
            <view wx:for="{{checkinTagOptions.safety}}" wx:key="value"
              class="ck-tag {{checkinSafety === item.value ? 'on' : ''}}"
              data-dim="safety" data-value="{{item.value}}" bindtap="onCheckinTagTap">
              <text class="ck-tag-emoji">{{item.emoji}}</text>
              <text class="ck-tag-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 信号 -->
        <view class="checkin-section">
          <view class="checkin-label">手机信号</view>
          <view class="checkin-tags">
            <view wx:for="{{checkinTagOptions.signal}}" wx:key="value"
              class="ck-tag {{checkinSignal === item.value ? 'on' : ''}}"
              data-dim="signal" data-value="{{item.value}}" bindtap="onCheckinTagTap">
              <text class="ck-tag-emoji">{{item.emoji}}</text>
              <text class="ck-tag-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 地面 -->
        <view class="checkin-section">
          <view class="checkin-label">地面情况</view>
          <view class="checkin-tags">
            <view wx:for="{{checkinTagOptions.ground}}" wx:key="value"
              class="ck-tag {{checkinGround === item.value ? 'on' : ''}}"
              data-dim="ground" data-value="{{item.value}}" bindtap="onCheckinTagTap">
              <text class="ck-tag-emoji">{{item.emoji}}</text>
              <text class="ck-tag-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 文字评价 -->
        <view class="checkin-section">
          <view class="checkin-label">说说你的体验 <text class="checkin-optional">（选填）</text></view>
          <textarea class="checkin-textarea" value="{{checkinText}}" bindinput="onCheckinTextInput"
            placeholder="比如：晚上大车多有点吵，但是有保安很安心..." maxlength="200" auto-height="true" />
          <text class="checkin-word-count">{{checkinText.length}}/200</text>
        </view>

        <!-- 图片 -->
        <view class="checkin-section">
          <view class="checkin-label">上传照片 <text class="checkin-optional">（选填，最多6张）</text></view>
          <view class="checkin-photos">
            <view wx:for="{{checkinPhotos}}" wx:key="id" class="ck-photo-thumb">
              <image src="{{item.path}}" mode="aspectFill" class="ck-photo-img" />
              <view class="ck-photo-del" catchtap="delCheckinPhoto" data-idx="{{index}}">✕</view>
            </view>
            <view wx:if="{{checkinPhotos.length < 6}}" class="ck-photo-add" bindtap="addCheckinPhoto">
              <text class="ck-add-icon">📷</text>
              <text class="ck-add-text">添加</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="checkin-footer">
        <view class="checkin-points-tip">
          <text class="cp-icon">🎁</text>
          <text class="cp-text">带评价打卡 +15 积分</text>
        </view>
        <view class="checkin-submit {{submittingCheckin ? 'disabled' : ''}}" bindtap="submitCheckinReview">
          {{submittingCheckin ? '提交中...' : '提交打卡'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 昵称设置弹窗 (评论前需设置昵称) -->
  <view wx:if="{{showNickPopup}}" class="nick-popup">
    <view class="np-mask" bindtap="closeNickPopup"></view>
    <view class="np-box" catchtap="noop">
      <view class="np-title">设置昵称</view>
      <view class="np-desc">请输入您的昵称，用于评论展示</view>
      <view class="np-nick-row">
        <input class="np-input" type="nickname" placeholder="点击获取微信昵称"
          value="{{tempNick}}" bindinput="onNickInput" bindblur="onNickBlur" />
      </view>
      <view class="np-actions">
        <view class="np-cancel" bindtap="closeNickPopup">取消</view>
        <view class="np-save" bindtap="confirmNick">确定</view>
      </view>
    </view>
  </view>
</view>
