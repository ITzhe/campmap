/* pages/detail/index.wxss — 营地详情页样式 */

.page-detail {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 160rpx;
}

/* ============ 顶部渐变 + 导航 ============ */
.detail-hero {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-3) 100%);
  position: relative;
  overflow: hidden;
}

.dn-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  gap: 12rpx;
  position: relative;
  z-index: 2;
}

.dn-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
  flex-shrink: 0;
}

.dn-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.dn-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.hero-content {
  height: 272rpx;
  padding: 0 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  position: relative;
  z-index: 2;
}

.hero-deco {
  position: absolute;
  right: 36rpx;
  top: 16rpx;
  font-size: 140rpx;
  opacity: 0.16;
  z-index: 1;
  line-height: 1;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* ============ 主体 ============ */
.detail-body {
  padding: 28rpx;
  margin-top: -28rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--bg);
  position: relative;
  z-index: 3;
}

/* ============ 地址 / 坐标 ============ */
.addr-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

.addr-pin {
  font-size: 28rpx;
  line-height: 1.5;
}

.addr-text {
  flex: 1;
}

/* ============ 停车信息卡片 ============ */
.price-card {
  padding: 24rpx 28rpx;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-badge {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.price-badge.free {
  background: #e8f5e9;
  color: var(--green);
}

.price-badge.paid {
  background: #fff3e0;
  color: var(--orange);
}

.price-detail {
  font-size: 26rpx;
  color: var(--text);
  flex: 1;
  line-height: 1.5;
}

.geo-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.geo-label {
  font-size: 22rpx;
  color: var(--green);
  background: var(--green-light);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.geo-val {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: var(--text-2);
}

/* ============ 营地简介 ============ */
.intro-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.75;
}

.intro-text:not(.expanded) {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.intro-toggle {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--green-2);
  text-align: center;
}

/* ============ 充电桩状态 ============ */
.charge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.charge-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.charge-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.charge-dot.on {
  background: var(--green-3);
  box-shadow: 0 0 0 6rpx rgba(82, 183, 136, 0.18);
}

.charge-dot.off {
  background: var(--text-ph);
}

.charge-text {
  font-size: 28rpx;
  font-weight: 600;
}

.charge-text.on {
  color: var(--green);
}

.charge-text.off {
  color: var(--text-2);
}

.charge-info {
  font-size: 24rpx;
  color: var(--text-2);
  text-align: right;
}

/* ============ 配套设施 ============ */
.fac-groups {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fac-group-title {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
  font-weight: 600;
}

.fac-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.fac-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.fac-tag.on {
  background: var(--green-light);
  color: var(--green);
}

.fac-tag.off {
  background: #f0f2f0;
  color: var(--text-ph);
}

.fac-emoji {
  font-size: 26rpx;
}

.fac-label {
  font-size: 24rpx;
}

/* ============ 营地备注 ============ */
.memo-card {
  background: var(--yellow-bg);
  border: 2rpx solid var(--yellow-bd);
  box-shadow: none;
}

.memo-h {
  color: #b8860b;
}

.memo-h .dot.memo-dot {
  background: var(--orange);
}

.memo-text {
  font-size: 26rpx;
  color: #8a6d3b;
  line-height: 1.7;
}

/* ============ 最新动态 ============ */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.news-date {
  font-size: 22rpx;
  color: var(--green-2);
  background: var(--green-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.news-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ============ 用户动态 ============ */
.dynamics-card {
  padding-bottom: 8rpx;
}

.dyn-count {
  font-size: 22rpx;
  color: var(--text-ph);
  margin-left: 8rpx;
  font-weight: 400;
}

.dyn-publish-trigger {
  background: #f8faf8;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx dashed var(--line);
}

.dyn-trigger-text {
  font-size: 26rpx;
  color: var(--text-ph);
}

.dyn-trigger-icon {
  font-size: 28rpx;
}

.dyn-publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.dyn-publish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.dyn-publish-collapse {
  font-size: 24rpx;
  color: var(--text-ph);
}

.dyn-publish {
  background: #f8faf8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.dyn-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

.dyn-publish-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dyn-photo-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid var(--line);
}

.dyn-photo-btn-icon {
  font-size: 28rpx;
}

.dyn-photo-btn-text {
  font-size: 22rpx;
  color: var(--text-2);
}

.dyn-publish-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dyn-char-count {
  font-size: 22rpx;
  color: var(--text-ph);
}

.dyn-publish-btn {
  background: var(--green);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 36rpx;
  border-radius: 24rpx;
}

.dyn-publish-btn.disabled {
  opacity: 0.6;
}

/* 评价图片选择 */
.dyn-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dyn-photo-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.dyn-photo-img {
  width: 100%;
  height: 100%;
}

.dyn-photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  border-radius: 0 12rpx 0 12rpx;
}

/* 评论列表中的图片 */
.dyn-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
  margin-bottom: 8rpx;
}

.dyn-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.dyn-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dyn-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.dyn-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.dyn-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.dyn-content {
  flex: 1;
  min-width: 0;
}

.dyn-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.dyn-nick {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.dyn-type-tag {
  font-size: 20rpx;
  color: var(--green);
  background: var(--green-light);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.dyn-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.dyn-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dyn-foot-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dyn-delete-btn {
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  background: #fdecea;
}

.dyn-delete-icon {
  font-size: 22rpx;
}

.dyn-date {
  font-size: 22rpx;
  color: var(--text-ph);
}

.dyn-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f4f7f5;
}

.dyn-like.liked {
  background: #fde8ec;
}

.dyn-like-icon {
  font-size: 24rpx;
}

.dyn-like-count {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 600;
}

.dyn-toggle {
  text-align: center;
  font-size: 24rpx;
  color: var(--green-2);
  padding: 20rpx 0 8rpx;
}

/* ============ 营地相册 ============ */
.photo-card {
  padding-bottom: 20rpx;
}

.photo-count {
  font-size: 22rpx;
  color: var(--text-ph);
  margin-left: 8rpx;
  font-weight: 400;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.photo-item {
  position: relative;
  width: 218rpx;
  height: 218rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  border-radius: 0 16rpx 0 16rpx;
}

.photo-empty {
  padding: 36rpx 0;
  text-align: center;
}

.photo-empty-text {
  font-size: 24rpx;
  color: var(--text-ph);
}

.photo-upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 22rpx 0;
  border-radius: 20rpx;
  background: var(--green-light);
  border: 2rpx dashed var(--green-3);
}

.photo-upload-btn.disabled {
  opacity: 0.5;
}

.photo-upload-icon {
  font-size: 30rpx;
}

.photo-upload-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--green);
}

/* 加载中 / 空状态提示 */
.dyn-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-ph);
  padding: 28rpx 0;
}

.bottom-spacer {
  height: 40rpx;
}

/* ============ 底部操作栏 ============ */
.detail-actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.ab-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 0;
}

.ab-btn .ab-icon {
  font-size: 36rpx;
}

.ab-btn .ab-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.ab-primary {
  flex: 1.4;
  background: var(--green);
  border-radius: 44rpx;
  margin-left: 24rpx;
  padding: 20rpx 0;
}

.ab-primary .ab-icon {
  font-size: 34rpx;
}

.ab-primary .ab-label {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

/* ============ 纠错弹窗 ============ */
.correction-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 7000;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
}

.correction-sheet {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.cs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.cs-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.cs-close {
  font-size: 36rpx;
  color: var(--text-ph);
  padding: 8rpx;
}

.cs-body {
  flex: 1;
  padding: 20rpx 32rpx;
  max-height: 60vh;
}

.cs-section {
  margin-bottom: 28rpx;
}

.cs-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 14rpx;
}

.cs-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #fafbfa;
}

.cs-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #fafbfa;
  box-sizing: border-box;
}

.cs-fac-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.cs-fac-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 8rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: #fff;
  position: relative;
}

.cs-fac-item.on {
  background: var(--green-light);
  border-color: var(--green-3);
}

.cs-fac-item.off {
  opacity: 0.5;
}

.cs-fac-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.cs-fac-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.cs-fac-item.on .cs-fac-label {
  color: var(--green);
  font-weight: 600;
}

.cs-fac-status {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  font-size: 20rpx;
}

.cs-fac-item.on .cs-fac-status {
  color: var(--green);
}

.cs-fac-item.off .cs-fac-status {
  color: var(--text-ph);
}

.cs-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cs-photo-thumb {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.cs-photo-img {
  width: 100%;
  height: 100%;
}

.cs-photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  border-radius: 0 12rpx 0 12rpx;
}

.cs-photo-add {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed var(--text-ph);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-add-icon {
  font-size: 48rpx;
  color: var(--text-ph);
}

.cs-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  border-top: 2rpx solid var(--line);
}

.cs-btn-cancel {
  flex: 1;
  height: 84rpx;
  border: 2rpx solid var(--line);
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.cs-btn-submit {
  flex: 1.4;
  height: 84rpx;
  border-radius: 42rpx;
  background: var(--green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cs-btn-submit.disabled {
  opacity: 0.6;
}
