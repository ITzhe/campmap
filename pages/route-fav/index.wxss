/* pages/route-fav/index.wxss — 线路收藏页样式 */

.page-routefav {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 摘要 ============ */
.rf-summary {
  padding: 20rpx 28rpx 0;
  font-size: 24rpx;
  color: var(--text-2);
}

/* ============ 列表 ============ */
.rf-list {
  padding: 16rpx 24rpx;
}

.rf-item {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rf-main {
  flex: 1;
  min-width: 0;
}

.rf-route {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 14rpx;
}

.rf-endpoint {
  max-width: 280rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rf-arrow {
  font-size: 28rpx;
  color: var(--green);
  flex-shrink: 0;
}

.rf-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rf-tag {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--green-light);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.rf-date {
  font-size: 22rpx;
  color: var(--text-ph);
}

.rf-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--red);
  padding: 12rpx 20rpx;
  border: 2rpx solid var(--red);
  border-radius: 28rpx;
  background: #fff;
}

.rf-del:active {
  background: var(--red);
  color: #fff;
}

/* ============ 空状态 ============ */
.rf-empty {
  margin: 120rpx 48rpx;
  text-align: center;
}

.rf-empty-icon {
  font-size: 120rpx;
  line-height: 1;
  opacity: 0.6;
}

.rf-empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-top: 28rpx;
}

.rf-empty-desc {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

.rf-empty-btn {
  margin: 36rpx auto 0;
  width: 280rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: var(--green);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(45, 106, 79, 0.28);
}
