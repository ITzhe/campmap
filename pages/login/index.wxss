/* pages/login/index.wxss — 登录/注册页样式 */
.page-login {
  min-height: 100vh;
  background: var(--bg);
}

/* ============ 顶部渐变区 ============ */
.login-bg {
  background: linear-gradient(160deg, var(--green), var(--green-2));
  padding: 0 32rpx 60rpx;
  position: relative;
}

.lb-back {
  width: 64rpx;
  height: 64rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #fff;
}

.lb-logo {
  text-align: center;
  font-size: 88rpx;
  line-height: 1;
  margin-top: 20rpx;
}

.lb-title {
  text-align: center;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-top: 16rpx;
}

.lb-subtitle {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* ============ 表单区 ============ */
.login-form {
  margin: -30rpx 32rpx 0;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  z-index: 2;
}

/* 头像 */
.lf-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.lf-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--green-light);
  border: 4rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.lf-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.lf-avatar-placeholder {
  font-size: 56rpx;
}

.lf-avatar-hint {
  font-size: 24rpx;
  color: var(--text-ph);
}

/* 输入字段 */
.lf-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
}

.lf-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.lf-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  height: 100%;
}

/* 手机号区 */
.lf-phone-section {
  margin-bottom: 32rpx;
}

.lf-phone-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  font-weight: 600;
}

.lf-phone-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--bg);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: var(--text-ph);
  border: none;
  text-align: left;
  padding: 0 24rpx;
  margin: 0;
}

.lf-phone-btn::after {
  border: none;
}

.lf-phone-hint {
  font-size: 22rpx;
  color: var(--text-ph);
  margin-top: 10rpx;
}

/* 协议 */
.lf-agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.lf-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--text-ph);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.lf-check.on {
  background: var(--green);
  border-color: var(--green);
}

.lf-agree-text {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.lf-link {
  color: var(--green);
}

/* 登录按钮 */
.lf-login-btn {
  height: 96rpx;
  background: var(--green);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.lf-login-btn.disabled {
  background: var(--green-light);
  color: var(--text-ph);
}

/* 跳过 */
.lf-skip {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-ph);
  margin-top: 28rpx;
  padding: 12rpx;
}
