/* pages/login/index.wxss — 登录/注册页样式 */
.page-login {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

/* ============ 导航栏 ============ */
.lb-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  flex-shrink: 0;
}

.lb-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #333;
}

.lb-nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.lb-nav-right {
  width: 56rpx;
}

/* ============ 品牌区 ============ */
.lb-brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 60rpx;
}

.lb-logo-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.lb-logo {
  font-size: 64rpx;
  line-height: 1;
}

.lb-brand-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
}

.lb-brand-slogan {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ============ 按钮区 ============ */
.lb-actions {
  padding: 0 48rpx 32rpx;
}

.lb-btn-primary {
  height: 96rpx;
  background: var(--green);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.lb-btn-outline {
  height: 96rpx;
  background: #fff;
  border: 2rpx solid var(--green);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--green);
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.lb-btn-phone-icon {
  font-size: 36rpx;
}

.lb-skip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 12rpx;
}

/* ============ 底部协议 ============ */
.lb-agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.lb-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.lb-check.on {
  background: var(--green);
  border-color: var(--green);
}

.lb-agree-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.lb-link {
  color: var(--green);
}

/* ============ 底部弹窗通用 ============ */
.lb-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.lb-mask.show {
  opacity: 1;
  visibility: visible;
}

.lb-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.lb-mask.show .lb-sheet {
  transform: translateY(0);
}

/* 弹窗头部 */
.lb-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.lb-sheet-app {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lb-sheet-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.lb-sheet-app-name {
  font-size: 26rpx;
  color: #666;
}

.lb-sheet-close {
  font-size: 36rpx;
  color: #ccc;
  padding: 8rpx;
}

/* 弹窗标题 */
.lb-sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-top: 32rpx;
}

.lb-sheet-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* 信息项 */
.lb-sheet-items {
  margin-top: 32rpx;
}

.lb-sheet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  gap: 20rpx;
}

.lb-sheet-item:last-child {
  border-bottom: none;
}

.lb-item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lb-item-icon {
  font-size: 36rpx;
}

.lb-item-content {
  flex: 1;
  min-width: 0;
}

.lb-item-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.lb-item-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 昵称输入框 */
.lb-item-input-wrap {
  flex-shrink: 0;
  width: 200rpx;
}

.lb-nick-input {
  width: 100%;
  height: 64rpx;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

/* 手机号按钮 */
.lb-item-btn-wrap {
  flex-shrink: 0;
}

.lb-phone-btn {
  font-size: 28rpx;
  color: var(--green);
  background: transparent;
  border: 2rpx solid var(--green);
  border-radius: 8rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  min-width: 180rpx;
  text-align: center;
}

.lb-phone-btn::after {
  border: none;
}

.lb-phone-btn.done {
  color: #fff;
  background: var(--green);
  border-color: var(--green);
}

/* 手机验证码表单 */
.lb-sheet-form {
  margin-top: 32rpx;
}

.lb-form-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
}

.lb-form-prefix {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding-right: 20rpx;
  border-right: 2rpx solid #e0e0e0;
  margin-right: 20rpx;
}

.lb-form-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
}

.lb-form-code {
  flex: 1;
}

.lb-sms-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--green);
  padding: 0 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  white-space: nowrap;
}

.lb-sms-btn.disabled {
  color: #ccc;
}

/* 弹窗操作按钮 */
.lb-sheet-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.lb-sheet-deny {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #666;
  background: var(--bg);
  border-radius: 12rpx;
}

.lb-sheet-allow {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #fff;
  background: var(--green);
  border-radius: 12rpx;
  font-weight: 600;
}
