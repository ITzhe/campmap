<!-- pages/login/index.wxml — 登录/注册页 -->
<view class="page-login">
  <!-- 顶部渐变背景 -->
  <view class="login-bg" style="padding-top: {{statusBarHeight}}px;">
    <view class="lb-back" bindtap="goBack">‹</view>
    <view class="lb-logo">🏕</view>
    <view class="lb-title">营图</view>
    <view class="lb-subtitle">发现身边的露营地</view>
  </view>

  <!-- 表单区 -->
  <view class="login-form">
    <!-- 头像选择 -->
    <view class="lf-avatar-row">
      <view class="lf-avatar-wrap" bindtap="chooseAvatarFromAlbum">
        <image wx:if="{{tempAvatarUrl}}" class="lf-avatar-img" src="{{tempAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="lf-avatar-placeholder">📷</view>
      </view>
      <view class="lf-avatar-hint">点击设置头像</view>
    </view>

    <!-- 昵称 (type=nickname 触发微信原生选择) -->
    <view class="lf-field">
      <text class="lf-icon">👤</text>
      <input class="lf-input" type="nickname" placeholder="点击获取微信昵称"
        value="{{tempNick}}" bindinput="onNickInput" bindblur="onNickBlur" />
    </view>

    <!-- 手机号登录 -->
    <view class="lf-phone-section">
      <view class="lf-phone-label">手机号登录（选填）</view>
      <button class="lf-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        {{phoneText}}
      </button>
      <view class="lf-phone-hint">用于营地审核联系，不会公开展示</view>
    </view>

    <!-- 协议勾选 -->
    <view class="lf-agreement">
      <view class="lf-check {{agreed ? 'on' : ''}}" bindtap="toggleAgree">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <view class="lf-agree-text">
        我已阅读并同意
        <text class="lf-link" catchtap="goPrivacy">《用户隐私协议》</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="lf-login-btn {{canLogin ? '' : 'disabled'}}" bindtap="doLogin">
      完成登录
    </view>

    <view class="lf-skip" bindtap="goBack">暂不登录，先逛逛</view>
  </view>
</view>
