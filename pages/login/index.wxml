<!-- pages/login/index.wxml — 登录/注册页 -->
<view class="page-login">
  <!-- 导航栏 -->
  <view class="lb-navbar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="lb-back" bindtap="goBack">‹</view>
    <view class="lb-nav-title">登录营图</view>
    <view class="lb-nav-right"></view>
  </view>

  <!-- 品牌区 -->
  <view class="lb-brand">
    <view class="lb-logo-wrap">
      <view class="lb-logo">🏕</view>
    </view>
    <view class="lb-brand-name">营图</view>
    <view class="lb-brand-slogan">发现身边的露营地</view>
  </view>

  <!-- 按钮区 -->
  <view class="lb-actions">
    <view class="lb-btn-primary" bindtap="onWeChatLogin">微信快捷登录</view>
    <view class="lb-btn-outline" bindtap="onPhoneCodeLogin">
      <text class="lb-btn-phone-icon">📱</text>
      <text>手机号验证码登录</text>
    </view>
    <view class="lb-skip" bindtap="goBack">暂不登录 〉</view>
  </view>

  <!-- 底部协议勾选 -->
  <view class="lb-agreement">
    <view class="lb-check {{agreed ? 'on' : ''}}" bindtap="toggleAgree">
      <text wx:if="{{agreed}}">✓</text>
    </view>
    <view class="lb-agree-text">
      打勾表示您已阅读并同意
      <text class="lb-link" catchtap="goPrivacy">《用户隐私协议》</text>
    </view>
  </view>
</view>

<!-- ========== 微信快捷登录授权弹窗 ========== -->
<!-- 遮罩层（独立，不包裹sheet，避免catchtap干扰open-type按钮） -->
<view class="lb-mask {{showWxSheet ? 'show' : ''}}" bindtap="hideWxSheet"></view>
<!-- 底部弹窗（与遮罩平级，sheet内部不需要catchtap） -->
<view class="lb-sheet-wrap {{showWxSheet ? 'show' : ''}}">
  <view class="lb-sheet">
    <!-- 弹窗头部：应用标识 -->
    <view class="lb-sheet-header">
      <view class="lb-sheet-app">
        <view class="lb-sheet-logo">🏕</view>
        <text class="lb-sheet-app-name">营图 | 发现身边的露营地</text>
      </view>
      <view class="lb-sheet-close" bindtap="hideWxSheet">✕</view>
    </view>

    <!-- 标题区 -->
    <view class="lb-sheet-title">申请获取以下信息</view>
    <view class="lb-sheet-desc">用于完善你的账号资料，保障账号安全</view>

    <!-- 信息项 -->
    <view class="lb-sheet-items">
      <!-- 微信昵称 -->
      <view class="lb-sheet-item">
        <view class="lb-item-icon-wrap"><text class="lb-item-icon">👤</text></view>
        <view class="lb-item-content">
          <view class="lb-item-label">微信昵称</view>
          <view class="lb-item-sub">用于展示你的昵称</view>
        </view>
        <view class="lb-item-input-wrap">
          <input class="lb-nick-input" type="nickname" placeholder="点击获取"
            value="{{wxNick}}" bindinput="onWxNickInput" bindblur="onWxNickBlur"
            cursor-spacing="60" />
        </view>
      </view>

      <!-- 手机号 -->
      <view class="lb-sheet-item">
        <view class="lb-item-icon-wrap"><text class="lb-item-icon">📱</text></view>
        <view class="lb-item-content">
          <view class="lb-item-label">手机号</view>
          <view class="lb-item-sub">用于营地审核联系，不会公开展示</view>
        </view>
        <view class="lb-item-btn-wrap">
          <button class="lb-phone-btn {{phoneObtained ? 'done' : ''}}"
            open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
            {{phoneObtained ? '✓ 已获取' : '获取手机号'}}
          </button>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="lb-sheet-actions">
      <view class="lb-sheet-deny" bindtap="hideWxSheet">不允许</view>
      <view class="lb-sheet-allow" bindtap="confirmWxLogin">允许</view>
    </view>
  </view>
</view>

<!-- ========== 手机号验证码登录弹窗 ========== -->
<view class="lb-mask {{showPhoneSheet ? 'show' : ''}}" bindtap="hidePhoneSheet"></view>
<view class="lb-sheet-wrap {{showPhoneSheet ? 'show' : ''}}">
  <view class="lb-sheet">
    <!-- 弹窗头部 -->
    <view class="lb-sheet-header">
      <view class="lb-sheet-app">
        <view class="lb-sheet-logo">🏕</view>
        <text class="lb-sheet-app-name">营图 | 手机号登录</text>
      </view>
      <view class="lb-sheet-close" bindtap="hidePhoneSheet">✕</view>
    </view>

    <!-- 标题区 -->
    <view class="lb-sheet-title">手机号验证码登录</view>
    <view class="lb-sheet-desc">输入手机号获取验证码完成登录</view>

    <!-- 表单 -->
    <view class="lb-sheet-form">
      <view class="lb-form-row">
        <view class="lb-form-prefix">+86</view>
        <input class="lb-form-input" type="number" maxlength="11"
          placeholder="请输入手机号" value="{{phoneInput}}"
          bindinput="onPhoneInput" cursor-spacing="60" />
      </view>
      <view class="lb-form-row">
        <input class="lb-form-input lb-form-code" type="number" maxlength="6"
          placeholder="请输入验证码" value="{{smsCode}}"
          bindinput="onSmsCodeInput" cursor-spacing="60" />
        <view class="lb-sms-btn {{smsCountdown > 0 ? 'disabled' : ''}}" bindtap="sendSmsCode">
          {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="lb-sheet-actions">
      <view class="lb-sheet-deny" bindtap="hidePhoneSheet">取消</view>
      <view class="lb-sheet-allow" bindtap="confirmPhoneLogin">确认登录</view>
    </view>
  </view>
</view>
