<!-- pages/privacy/index.wxml — 隐私协议页 -->
<view class="page-privacy">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <!-- 自定义导航栏 -->
  <view class="navbar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">隐私协议</view>
  </view>

  <!-- 标题区 -->
  <view class="pv-hero">
    <view class="pv-hero-title">营图用户隐私保护协议</view>
    <view class="pv-hero-sub">最后更新：2026年8月17日</view>
  </view>

  <!-- 引言 -->
  <view class="pv-card">
    <view class="pv-intro">营图（以下简称"本应用"）是一款露营地图导航服务小程序。本应用高度重视用户隐私保护，严格遵守《中华人民共和国个人信息保护法》《中华人民共和国网络安全法》等相关法律法规。本协议旨在向您清晰说明本应用收集、使用、存储和保护您个人信息的方式和目的。请您在使用本应用前仔细阅读本协议，使用本应用即表示您同意本协议的全部内容。</view>
  </view>

  <!-- 一、收集的个人信息及目的 -->
  <view class="pv-card">
    <view class="pv-section-h">一、收集的个人信息及目的</view>

    <view class="pv-sub-h">1. 位置信息</view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集内容：</text>您的地理位置坐标（经纬度）</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集目的：</text>用于在地图上显示您附近的露营地、计算您与营地的距离、提供路线规划服务</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集场景：</text>打开地图首页时获取定位、使用路线规划功能时选择起终点</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">授权方式：</text>通过微信小程序 getLocation 接口获取，您可随时在微信设置中关闭授权</text>
    </view>

    <view class="pv-sub-h">2. 头像和昵称</view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集内容：</text>您的头像图片和昵称</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-bold">收集目的：</text>用于在评论、营地打卡、营地录入等场景中展示用户身份</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集场景：</text>您在「我的」页面主动设置头像和昵称时</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">授权方式：</text>通过微信 chooseAvatar 组件或从相册选择，仅在您主动操作时收集</text>
    </view>

    <view class="pv-sub-h">3. 用户发布内容</view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集内容：</text>营地评价文字及图片、营地照片、营地纠错信息、营地录入信息、意见反馈</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集目的：</text>用于展示用户生成内容（UGC），丰富营地信息，帮助其他用户选择营地</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集场景：</text>您在营地详情页发布评价/照片/纠错、在营地录入页提交新营地、在意见反馈页提交反馈时</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">内容安全：</text>所有用户发布的文字和图片内容均会通过微信内容安全API（msgSecCheck/imgSecCheck）进行检测，违规内容将被拦截并提示用户修改</text>
    </view>

    <view class="pv-sub-h">4. 设备信息</view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集内容：</text>设备型号、操作系统版本、屏幕尺寸</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">·</text>
      <text class="pv-item-txt"><text class="pv-bold">收集目的：</text>用于适配界面显示、保障小程序正常运行</text>
    </view>
  </view>

  <!-- 二、信息使用 -->
  <view class="pv-card">
    <view class="pv-section-h">二、信息使用</view>
    <view class="pv-item">
      <text class="pv-item-num">1、</text>
      <text class="pv-item-txt">本应用收集的个人信息仅用于上述明确的目的，不会用于其他用途。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">2、</text>
      <text class="pv-item-txt">本应用不会向任何无关第三方提供、出售、出租、分享或交易您的个人信息。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">3、</text>
      <text class="pv-item-txt">本应用不允许任何第三方以任何手段收集、编辑、出售或无偿传播您的个人信息。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">4、</text>
      <text class="pv-item-txt">本应用严禁用户发布不良信息，如裸露、色情和亵渎内容。所有用户发布的内容均经过微信内容安全API检测，一旦发现不良信息，将拒绝发布并提醒用户修改。情节严重者将禁用相关权限。</text>
    </view>
  </view>

  <!-- 三、信息披露 -->
  <view class="pv-card">
    <view class="pv-section-h">三、信息披露</view>
    <view class="pv-note">在以下情况下，本应用将依据您的个人意愿或法律规定，全部或部分披露您的个人信息：</view>
    <view class="pv-item">
      <text class="pv-item-num">1、</text>
      <text class="pv-item-txt">未经您事先同意，我们不会向第三方披露您的个人信息。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">2、</text>
      <text class="pv-item-txt">根据法律相关规定，或行政、司法机构的要求，向第三方或行政、司法机构披露。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">3、</text>
      <text class="pv-item-txt">如您出现违反中国有关法律、法规或本应用服务协议的情况，需向第三方披露。</text>
    </view>
  </view>

  <!-- 四、信息存储与保护 -->
  <view class="pv-card">
    <view class="pv-section-h">四、信息存储与保护</view>
    <view class="pv-item">
      <text class="pv-item-num">1、</text>
      <text class="pv-item-txt">您的个人信息存储在安全的云服务器（Supabase）和对象存储（阿里云OSS）中，采用HTTPS加密传输。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">2、</text>
      <text class="pv-item-txt">数据库启用行级安全策略（RLS），确保用户只能访问和修改自己的数据。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">3、</text>
      <text class="pv-item-txt">本应用已采取技术措施防止批量数据获取，包括地理范围限制、请求频率限制、返回行数限制等。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">4、</text>
      <text class="pv-item-txt">在您删除本应用或撤销授权后，我们将按照法律法规要求在合理期限内删除您的个人信息。</text>
    </view>
  </view>

  <!-- 五、您的权利 -->
  <view class="pv-card">
    <view class="pv-section-h">五、您的权利</view>
    <view class="pv-item">
      <text class="pv-item-num">1、</text>
      <text class="pv-item-txt"><text class="pv-bold">查询和访问：</text>您可以在「我的」页面查看您的昵称、头像等信息。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">2、</text>
      <text class="pv-item-txt"><text class="pv-bold">更正和修改：</text>您可以随时在「我的」页面修改您的昵称和头像。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">3、</text>
      <text class="pv-item-txt"><text class="pv-bold">撤回授权：</text>您可以在微信「设置-隐私-授权管理」中撤回位置、相册等授权。撤回后相关功能将无法使用。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">4、</text>
      <text class="pv-item-txt"><text class="pv-bold">删除账号：</text>您可以通过「意见反馈」联系我们删除账号及相关数据。</text>
    </view>
  </view>

  <!-- 六、未成年人保护 -->
  <view class="pv-card">
    <view class="pv-section-h">六、未成年人保护</view>
    <view class="pv-p">本应用主要面向成年用户。若您是未满18周岁的未成年人，请在监护人的陪同下阅读本协议并使用本应用。监护人应承担对未成年人使用本应用的监督责任。</view>
  </view>

  <!-- 七、本隐私政策的更改 -->
  <view class="pv-card">
    <view class="pv-section-h">七、本隐私政策的更改</view>
    <view class="pv-item">
      <text class="pv-item-num">1、</text>
      <text class="pv-item-txt">本应用保留随时修改本协议的权利，修改后的协议将在本页面发布。请您经常查看本协议。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">2、</text>
      <text class="pv-item-txt">如对本协议作出重大更改，我们将通过适当方式通知您。</text>
    </view>
  </view>

  <!-- 八、数据版权与禁止爬取 -->
  <view class="pv-card">
    <view class="pv-section-h">八、数据版权与禁止爬取</view>
    <view class="pv-item">
      <text class="pv-item-num">1、</text>
      <text class="pv-item-txt">本应用所展示的全部营地数据、图文信息、界面设计及相关内容，其知识产权及所有权均归营图平台所有，受中华人民共和国著作权法及相关法律法规保护。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">2、</text>
      <text class="pv-item-txt">未经营图平台书面授权，任何单位或个人不得以任何方式（包括但不限于爬虫抓取、数据抓取、批量复制、镜像、转载、摘编等）获取、存储、使用、传播本应用的营地数据及其他受版权保护的内容。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">3、</text>
      <text class="pv-item-txt">本应用已采取技术措施限制批量数据获取，包括但不限于地理范围限制、请求频率限制、返回行数限制等。任何试图绕过这些技术措施的行为均构成侵权。</text>
    </view>
    <view class="pv-item">
      <text class="pv-item-num">4、</text>
      <text class="pv-item-txt">对于侵犯营图平台知识产权和数据权益的行为，我们将依法追究其法律责任，包括但不限于要求停止侵权、赔偿损失等。</text>
    </view>
  </view>

  <!-- 结尾 -->
  <view class="pv-card">
    <view class="pv-closing">如您对本协议有任何疑问，可通过「意见反馈」功能与我们联系。感谢您的信任与使用！</view>
  </view>

  <view class="safe-bottom"></view>
</view>
