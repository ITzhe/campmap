/* pages/privacy/index.wxss — 隐私协议页样式 */

.page-privacy {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 标题区 ============ */
.pv-hero {
  background: linear-gradient(180deg, var(--green) 0%, var(--green-2) 100%);
  text-align: center;
  padding: 48rpx 40rpx 60rpx;
  color: #fff;
}

.pv-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.pv-hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

/* ============ 卡片 ============ */
.pv-card {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
}

/* 引言段落 */
.pv-intro {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
  text-indent: 2em;
}

/* ============ 章节标题（带左边绿色竖条） ============ */
.pv-section-h {
  position: relative;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--green);
  padding-left: 20rpx;
  margin-bottom: 20rpx;
}

.pv-section-h::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  background: var(--green);
  border-radius: 4rpx;
}

/* ============ 序号项 ============ */
.pv-item {
  display: flex;
  align-items: flex-start;
  padding-left: 16rpx;
  margin-top: 16rpx;
}

.pv-item:first-of-type {
  margin-top: 0;
}

.pv-item-num {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--green);
  line-height: 1.8;
}

.pv-item-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
}

/* 章节内提示语 / 单段落 */
.pv-note,
.pv-p {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
}

.pv-note {
  margin-bottom: 8rpx;
}

/* ============ 结尾 ============ */
.pv-closing {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
}

.pv-thanks {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--green);
  line-height: 1.8;
}
