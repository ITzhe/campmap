/* pages/tutorial/index.wxss — 使用教程页样式 */

.page-tutorial {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 顶部介绍 ============ */
.tut-intro {
  background: linear-gradient(180deg, var(--green) 0%, var(--green-2) 100%);
  text-align: center;
  padding: 24rpx 40rpx 56rpx;
  color: #fff;
}

.tut-intro-icon {
  font-size: 64rpx;
  line-height: 1;
}

.tut-intro-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 16rpx;
}

.tut-intro-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

/* ============ 步骤卡片 ============ */
.tut-list {
  padding: 0 24rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.tut-card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.tut-num {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--green);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

.tut-body {
  flex: 1;
  min-width: 0;
}

.tut-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.tut-icon {
  font-size: 34rpx;
  line-height: 1;
}

.tut-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.tut-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

/* ============ 底部提示 ============ */
.tut-tip {
  margin: 16rpx 24rpx 0;
  background: var(--green-light);
  border-radius: var(--radius-sm);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tut-tip-icon {
  font-size: 30rpx;
  line-height: 1;
}

.tut-tip-text {
  font-size: 24rpx;
  color: var(--green);
  flex: 1;
}
