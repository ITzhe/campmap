/* pages/about/index.wxss — 关于页面样式 */

.page-about {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 英雄区 ============ */
.about-hero {
  background: linear-gradient(180deg, var(--green) 0%, var(--green-2) 100%);
  text-align: center;
  padding: 68rpx 40rpx;
  color: #fff;
}

.about-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  margin: 0 auto;
}

.about-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 24rpx;
}

.about-ver {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

/* ============ 卡片 ============ */
.about-card {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
}

.about-h {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.about-h-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.about-p {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.8;
}
