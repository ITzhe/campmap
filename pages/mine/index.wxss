/* pages/mine/index.wxss — 我的页面样式 */

.page-mine {
  min-height: 100vh;
  background: var(--bg);
}

/* ============ 顶部渐变区 ============ */
.top-wrap {
  background: linear-gradient(160deg, var(--green), var(--green-2));
}

.navbar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

/* ============ 头部 ============ */
.mine-header {
  height: 240rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mh-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mh-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  overflow: hidden;
}

.mh-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.mh-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mh-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.mh-days {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mh-gear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
}

/* ============ 签到栏 ============ */
.checkin-bar {
  margin: -44rpx 24rpx 0;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.cb-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cb-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.pts {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--orange);
  line-height: 1.1;
}

.cb-streak {
  font-size: 22rpx;
  color: var(--text-2);
}

.cb-mid {
  font-size: 24rpx;
  color: var(--green);
  padding: 0 12rpx;
  font-weight: 500;
}

.cb-btn {
  background: var(--green);
  color: #fff;
  border-radius: 28rpx;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.cb-btn.done {
  background: var(--green-light);
  color: var(--green);
}

/* ============ 功能网格 ============ */
.grid-section {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx 0;
}

.gs-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  padding: 0 28rpx 20rpx;
}

.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 0 12rpx;
}

.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.func-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}

.func-label {
  font-size: 22rpx;
  color: var(--text-2);
}

/* ============ 设置列表 ============ */
.settings-list {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.set-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 2rpx solid var(--line);
}

.set-item:last-child {
  border-bottom: none;
}

.set-label {
  font-size: 28rpx;
  color: var(--text);
}

.set-item.danger .set-label {
  color: var(--red);
}

.set-arrow {
  font-size: 32rpx;
  color: var(--text-ph);
}

.set-item.danger .set-arrow {
  color: var(--red);
}

/* ============ 昵称编辑弹窗 ============ */
.nick-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9000;
}

.np-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.np-box {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 36rpx;
  z-index: 1;
}

.np-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  color: var(--text);
  margin-bottom: 36rpx;
}

/* 头像 */
.np-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.np-avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--green-light);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.np-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.np-avatar-placeholder {
  font-size: 56rpx;
  line-height: 1;
}

.np-avatar-hint {
  font-size: 22rpx;
  color: var(--text-ph);
}

/* 昵称输入 */
.np-nick-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  margin-bottom: 36rpx;
}

.np-label {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
  font-weight: 600;
}

.np-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  height: 100%;
}

/* 按钮 */
.np-actions {
  display: flex;
  gap: 20rpx;
}

.np-cancel {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid var(--line);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 600;
}

.np-save {
  flex: 1;
  height: 80rpx;
  background: var(--green);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
