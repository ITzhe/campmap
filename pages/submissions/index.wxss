/* pages/submissions/index.wxss — 我的提交页样式 */

.page-submissions {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 状态栏占位 (与导航栏同为绿色, 视觉连贯) */
.status-bar {
  width: 100%;
  background: var(--green);
}

/* ============ 统计栏 ============ */
.stats-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, var(--green) 0%, var(--green-2) 100%);
  padding: 12rpx 12rpx 44rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  color: #fff;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}

.stat-num.green {
  color: var(--green-light);
}

.stat-num.orange {
  color: #ffd9a8;
}

.stat-num.coin {
  font-size: 36rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

/* ============ 列表 ============ */
.sub-list {
  padding: 24rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

.sub-item {
  position: relative;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx 28rpx 28rpx 36rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 左侧状态色条 */
.sub-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

.sub-item.pending::before {
  background: var(--orange);
}

.sub-item.approved::before {
  background: var(--green);
}

.sub-item.rejected::before {
  background: var(--red);
}

.sub-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sub-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 状态徽标 */
.sub-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

.status-pending {
  background: rgba(244, 162, 97, 0.16);
  color: var(--orange);
}

.status-approved {
  background: var(--green-light);
  color: var(--green);
}

.status-rejected {
  background: rgba(238, 108, 77, 0.14);
  color: var(--red);
}

/* 地址 */
.sub-addr {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 14rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 元信息 */
.sub-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: var(--green);
  background: var(--green-light);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.meta-date {
  font-size: 22rpx;
  color: var(--text-ph);
}

/* 设施标签 */
.sub-fac {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
}

.fac-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 6rpx 14rpx;
}

.fac-emoji {
  font-size: 22rpx;
  line-height: 1;
}

.fac-label {
  font-size: 22rpx;
  color: var(--text-2);
}

/* 查看详情 */
.sub-arrow {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--green);
  font-weight: 600;
  text-align: right;
}

/* ============ 空状态 ============ */
.empty {
  margin: 140rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  line-height: 1;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-top: 28rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

.empty-btn {
  margin: 36rpx auto 0;
  width: 280rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: var(--green);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(45, 106, 79, 0.28);
}
