/* pages/search/index.wxss — 营地搜索页样式 */
.page-search {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 导航栏 + 搜索框 */
.ss-header {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.ss-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
  gap: 16rpx;
}

.ss-back {
  font-size: 44rpx;
  color: #333;
  width: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.ss-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 68rpx;
  gap: 12rpx;
}

.ss-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.ss-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.ss-btn {
  font-size: 28rpx;
  color: var(--green);
  font-weight: 600;
  flex-shrink: 0;
  padding: 8rpx 8rpx;
}

/* 搜索历史 */
.ss-history {
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.ss-history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ss-history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.ss-clear {
  font-size: 24rpx;
  color: #999;
}

.ss-history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ss-history-item {
  background: #f5f5f5;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #555;
}

/* 搜索中 */
.ss-loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 搜索结果 */
.ss-results {
  padding: 0 16rpx 32rpx;
}

.ss-result-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
}

.ss-empty {
  font-size: 80rpx;
  text-align: center;
  margin-top: 60rpx;
}

.ss-empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.ss-result-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.ss-ri-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.ss-ri-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ss-ri-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.ss-ri-badge.free {
  background: #e8f5e9;
  color: #2e7d32;
}

.ss-ri-badge.paid {
  background: #fff3e0;
  color: #e65100;
}

.ss-ri-addr {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ss-ri-tags {
  font-size: 28rpx;
  margin-top: 10rpx;
  letter-spacing: 4rpx;
}

.ss-ri-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 24rpx;
}

.ss-ri-map {
  font-size: 24rpx;
  color: var(--green);
  padding: 6rpx 0;
}
