/* pages/route/index.wxss — 线路规划页样式 */

.page-route {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ============ 导航栏 ============ */
.rn-bar {
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.rn-map-btn {
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  white-space: nowrap;
}

.rn-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.rn-placeholder {
  width: 100rpx;
}

/* ============ 路线输入 ============ */
.route-input {
  background: #fff;
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
}

.ri-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.ri-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ri-dot.start {
  background: var(--green);
}

.ri-dot.end {
  background: var(--red);
}

.ri-dot.way {
  background: var(--orange);
}

/* 途经点行 */
.ri-waypoint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.ri-way-del {
  font-size: 28rpx;
  color: var(--red);
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 途经点操作按钮组 */
.ri-way-btns {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.ri-way-btn {
  font-size: 28rpx;
  color: var(--green-2);
  padding: 4rpx 10rpx;
}

.ri-way-btn.disabled {
  color: var(--text-ph);
}

.ri-input {
  flex: 1;
  height: 68rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #fafbfa;
  display: flex;
  align-items: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ri-input.placeholder {
  color: var(--text-ph);
}

.ri-loc-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  padding: 0 8rpx;
}

.ri-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}

.ri-addway {
  font-size: 24rpx;
  color: var(--green-2);
  padding: 10rpx 0;
}

.ri-swap {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 10rpx 0;
}

.ri-hint {
  font-size: 22rpx;
  color: var(--text-ph);
  margin-top: 12rpx;
  text-align: center;
}

.ri-btn {
  width: 100%;
  height: 84rpx;
  background: var(--green);
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 地图 ============ */
.route-map {
  width: 100%;
  height: 520rpx;
  margin-bottom: 20rpx;
}

/* 没有路线结果时, 地图填充剩余空间, 隐藏白框 */
.route-map-full {
  height: calc(100vh - 520rpx);
  margin-bottom: 0;
}

/* 取消规划按钮 */
.ri-cancel {
  text-align: center;
  font-size: 26rpx;
  color: var(--red);
  padding: 16rpx 0 0;
}

/* ============ 路线结果 ============ */
.route-result {
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}

.rr-stat {
  display: flex;
  gap: 16rpx;
}

.rr-stat .s {
  flex: 1;
  background: var(--green-light);
  border-radius: 16rpx;
  padding: 22rpx 12rpx;
  text-align: center;
}

.s-val {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--green);
  line-height: 1.2;
}

.s-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--green-2);
  margin-left: 4rpx;
}

.s-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

/* ============ 沿途营地列表 ============ */
.rr-camph {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin: 28rpx 0 12rpx;
}

.camp-list {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.camp-list-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}

.camp-list-item:last-child {
  border-bottom: none;
}

.cli-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.cli-info {
  flex: 1;
  min-width: 0;
}

.cli-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.cli-addr {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cli-dist {
  font-size: 24rpx;
  color: var(--green-2);
  font-weight: 600;
  flex-shrink: 0;
  text-align: right;
}

.cli-dist-main {
  font-size: 26rpx;
  color: var(--green-2);
  font-weight: 700;
}

.cli-dist-off {
  font-size: 20rpx;
  color: var(--text-ph);
  margin-top: 4rpx;
  font-weight: 400;
}

.camp-empty {
  padding: 44rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-ph);
}

/* ============ 底部间距 ============ */
.bottom-spacer {
  height: 40rpx;
}
