<!-- pages/route/index.wxml — 线路规划页 -->
<view class="page-route">
  <!-- 自定义导航栏 -->
  <view class="rn-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="rn-map-btn" bindtap="goToMap">🗺 地图</view>
    <view class="rn-title">线路规划</view>
    <view class="rn-placeholder"></view>
  </view>

  <!-- 路线输入 -->
  <view class="route-input">
    <view class="ri-row" bindtap="chooseStart">
      <view class="ri-dot start"></view>
      <view class="ri-input {{routeStart ? '' : 'placeholder'}}">{{routeStart || '点击选择起点'}}</view>
      <view class="ri-loc-icon">📍</view>
    </view>

    <!-- 途经点列表 -->
    <view class="ri-waypoint" wx:for="{{waypoints}}" wx:key="id" data-idx="{{index}}">
      <view class="ri-dot way"></view>
      <view class="ri-input" bindtap="chooseWaypoint" data-idx="{{index}}">{{item.name}}</view>
      <view class="ri-way-btns">
        <view class="ri-way-btn {{index === 0 ? 'disabled' : ''}}" catchtap="moveWaypointUp" data-idx="{{index}}">↑</view>
        <view class="ri-way-btn {{index === waypoints.length - 1 ? 'disabled' : ''}}" catchtap="moveWaypointDown" data-idx="{{index}}">↓</view>
        <view class="ri-way-del" catchtap="removeWaypoint" data-idx="{{index}}">✕</view>
      </view>
    </view>

    <view class="ri-row" bindtap="chooseEnd">
      <view class="ri-dot end"></view>
      <view class="ri-input {{routeEnd ? '' : 'placeholder'}}">{{routeEnd || '点击选择终点'}}</view>
      <view class="ri-loc-icon">📍</view>
    </view>
    <view class="ri-actions">
      <view class="ri-addway" bindtap="addWaypoint">＋ 添加途经点{{waypoints.length > 0 ? '(' + waypoints.length + ')' : ''}}</view>
      <view class="ri-swap" bindtap="swapRoute">⇅ 交换</view>
    </view>
    <button class="ri-btn" bindtap="calcRoute" disabled="{{routePlanning}}">{{routePlanning ? '规划中...' : '规划路线'}}</button>
    <view class="ri-cancel" wx:if="{{showCancelBtn}}" bindtap="cancelRoutePlanning">取消规划</view>
    <view class="ri-hint">提示：点击输入框通过地图选择准确位置</view>
  </view>

  <!-- 路线地图 -->
  <map class="route-map {{!showResult ? 'route-map-full' : ''}}"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
  ></map>

  <!-- 路线结果 -->
  <view class="route-result" wx:if="{{showResult}}">
    <view class="rr-stat">
      <view class="s">
        <view class="s-val">{{routeDist}}<text class="s-unit">km</text></view>
        <view class="s-label">总里程</view>
      </view>
      <view class="s">
        <view class="s-val">{{routeCamps}}<text class="s-unit">个</text></view>
        <view class="s-label">沿途营地</view>
      </view>
      <view class="s">
        <view class="s-val">{{routeTime}}</view>
        <view class="s-label">预计时长</view>
      </view>
    </view>

    <view class="rr-camph">沿途营地 <text class="rr-camph-hint">点击查看详情</text></view>
    <view class="camp-list">
      <view class="camp-list-item"
        wx:for="{{routeCampList}}" wx:key="spot_code"
        data-idx="{{index}}" bindtap="onCampTap">
        <view class="cli-icon">🏕</view>
        <view class="cli-info">
          <view class="cli-name">{{item.name}}</view>
          <view class="cli-addr">{{item.address || '暂无地址'}}</view>
        </view>
        <view class="cli-dist">
          <view class="cli-dist-main">{{item.distance}} km</view>
          <view class="cli-dist-off">偏路线 {{item.offset}}km</view>
          <view class="cli-add-btn" catchtap="addCampToRoute" data-idx="{{index}}">+途经</view>
        </view>
      </view>
      <view class="camp-empty" wx:if="{{routeCampList.length === 0}}">沿途暂无营地</view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
